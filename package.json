{
  "name": "@spriteday/pi-system-prompt",
  "version": "0.0.1-alpha",
  "packageManager": "pnpm@11.5.2",
  "private": true,
  "scripts": {
    "fmt": "biome format --write ./src ./scripts",
    "lint": "biome lint ./src ./scripts",
    "ts": "tsc --noEmit",
    "emit": "tsx scripts/emit-system-prompt.mts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0",
    "@types/node": "24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6"
  }
}